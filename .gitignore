# dependencies
/node_modules
/.pnp
.pnp.js

# production build
/build
/dist

# testing
/coverage

# environment variables — never commit real tokens
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# misc
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor/IDE directories
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
*.pem
secrets/

